#!/bin/sh
# tests/cfg KEY=VALUE...: write a patina.toml holding these settings (expert settings are
# config keys only) into $RUNS and print its path, for `patina run --config "$(cfg ...)"`.
# Test inputs (stall-ms, pause-points, ...) are environment variables, not keys: AGENTS.md.
set -eu
f=$(mktemp "${RUNS:-${TMPDIR:-/tmp}}/cfg-XXXXXX.toml")
run="" faults="" sched="" sweep=""
for kv in "$@"; do
    k=${kv%%=*} v=${kv#*=}
    case $v in
        true | false | *[!0-9]* | '') case $v in true | false) ;; *) v="\"$v\"" ;; esac ;;
    esac
    case $k in
        disk-mb | time-limit | timeout | cpus | log-limit | check-timeout) run="$run$k = $v
" ;;
        fs-model) faults="$faults$k = $v
" ;;
        crash-pairs) sweep="$sweep$k = $v
" ;;
        preempt | preempt-permille) sched="$sched$k = $v
" ;;
        *) echo "cfg: unknown key $k" >&2; exit 2 ;;
    esac
done
{
    [ -z "$run" ] || printf '[run]\n%s\n' "$run"
    [ -z "$faults" ] || printf '[faults]\n%s\n' "$faults"
    [ -z "$sched" ] || printf '[sched]\n%s\n' "$sched"
    [ -z "$sweep" ] || printf '[sweep]\n%s\n' "$sweep"
} >"$f"
echo "$f"
