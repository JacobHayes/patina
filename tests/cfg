#!/bin/sh
# tests/cfg KEY=VALUE...: write a patina.toml holding these settings (expert settings are
# config keys only) into $RUNS and print its path, for `patina run --config "$(cfg ...)"`.
# A pmu-* or branches key also turns counter preemption on (preempt = "branches").
set -eu
f=$(mktemp "${RUNS:-${TMPDIR:-/tmp}}/cfg-XXXXXX.toml")
run="" faults="" sched=""
for kv in "$@"; do
    k=${kv%%=*} v=${kv#*=}
    case $v in
        true | false | *[!0-9]* | '') case $v in true | false) ;; *) v="\"$v\"" ;; esac ;;
    esac
    case $k in
        tmpfs-bytes | time-limit | timeout | cpus) run="$run$k = $v
" ;;
        fs-model | max-incarnations | faults-in-recovery) faults="$faults$k = $v
" ;;
        pmu-* | branches) sched="$sched$k = $v
preempt = \"branches\"
" ;;
        preempt | preempt-permille | stall-ms | host-cpu | pause-points | spin-probes) sched="$sched$k = $v
" ;;
        *) echo "cfg: unknown key $k" >&2; exit 2 ;;
    esac
done
# `preempt` once, whatever set it.
sched=$(printf '%s' "$sched" | awk '!(/^preempt = / && seen++)')
{
    [ -z "$run" ] || printf '[run]\n%s\n' "$run"
    [ -z "$faults" ] || printf '[faults]\n%s\n' "$faults"
    [ -z "$sched" ] || printf '[sched]\n%s\n' "$sched"
} >"$f"
echo "$f"
