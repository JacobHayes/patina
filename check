#!/bin/bash
# ./check quick              the landing gate (budget 5 min, ceiling 10)
# ./check AREA [AREA ...]    one area's checks (a directory under tests/) while working on it
# ./check evidence [NAME..]  one-off measurements (sweeps, matrices, soaks), by hand
# ./check release            the release gate and the nightly job (ceiling 10 min)
# ./check list               every script with its tier and budget
# ./check areas              the areas with a script for this machine (the nightly runs each)
# Builds patina (the runtime is embedded; a failed build stops here), builds the guests once per
# source change (tests/guests.sh; a failed guest build stops here), then runs the scripts in
# parallel (tests/run.py: the build under test, per-script times and budgets, total; it refuses
# a binary older than the sources it is built from). Output, the guest cache and scratch go under PATINA_CHECK_DIR (default
# target/patina-check).
set -euo pipefail; shopt -s inherit_errexit
cd "$(dirname "$0")"
root=$(pwd)
[ $# -ge 1 ] || { sed -n '2,7p' "$0" >&2; exit 2; }
command -v jq >/dev/null || { echo "check: jq is missing (apt install jq): the check scripts read JSON with it" >&2; exit 1; }
case $1 in list | areas) exec python3 -I tests/run.py "$1" ;; esac

export PATINA_CHECK_DIR="${PATINA_CHECK_DIR:-$root/target/patina-check}"
mkdir -p "$PATINA_CHECK_DIR"
t0=$(date +%s)
# A failed build stops here, with the compiler's errors on stderr: nothing runs against the
# binary of an earlier build.
msgs=$PATINA_CHECK_DIR/build-messages.json
cargo build --release --quiet -p patina-cli --message-format=json-render-diagnostics >"$msgs" ||
    { echo "check: the patina build failed; no script was run" >&2; exit 1; }
# RT_BIN: the runtime binary patina embeds (for scripts that inspect it), from the build script's
# output directory.
out=$(python3 -I -c '
import json, sys
for line in open(sys.argv[1]):
    m = json.loads(line)
    if m.get("reason") == "build-script-executed" and ("/patina-cli#" in m["package_id"] or "#patina-cli@" in m["package_id"]):
        print(m["out_dir"])' "$msgs")
case $(uname -m) in
    aarch64) rt_target=aarch64-unknown-none-softfloat ;;
    *) rt_target=x86_64-unknown-none ;;
esac
export RT_BIN="$out/rt-target/$rt_target/release/patina-rt"
[ -f "$RT_BIN" ] || { echo "check: no runtime at $RT_BIN" >&2; exit 1; }
# The unit and integration tests' binaries (sched/09-unit runs them): built here, outside the
# timed scripts.
case " $* " in
    *" quick "* | *" sched "*)
        cargo test --release --quiet --no-run -p patina-proto -p patina-cli 2>"$PATINA_CHECK_DIR/unit-build.log" ||
            { cat "$PATINA_CHECK_DIR/unit-build.log" >&2; echo "check: the unit tests' build failed; no script was run" >&2; exit 1; } ;;
esac
set=$(bash tests/guests.sh)
echo "== build: $(( $(date +%s) - t0 )) s (guests: $set)"

export PATINA="$root/target/release/patina" PATINA_CFG="$root/tests/cfg"
export PATINA_GUESTS="$set/guests" PATINA_WORKLOADS="$set/workloads" PATINA_ATTACK_GUESTS="$set/attack" PATINA_SANDBOX_GUESTS="$set/sandbox"

if [ "$1" = evidence ]; then
    # One evidence run on the host at a time (it uses up to 8 sandboxes for up to an hour).
    lock=${PATINA_EVIDENCE_LOCK:-$PATINA_CHECK_DIR/evidence.lock}
    exec 9>"$lock"
    flock -n 9 || { echo "== waiting for $lock (another evidence run)"; flock 9; }
fi
exec python3 -I tests/run.py "$@"
