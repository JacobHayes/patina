#!/bin/sh
# confined ROOT... RUN: every change to the work tree (a create, write, rename, unlink, ...;
# not a close or a sync) is on a path under one of the ROOTs, named as the program sees it
# (/work/data). Reads the `op` events of `patina log events`. For `patina run --check`.
set -eu
for run; do :; done
roots=$(for r; do [ "$r" = "$run" ] || printf '%s\n' "$r"; done | jq -Rsc 'split("\n")[:-1]')
bad=$({ "${PATINA:-patina}" log events "$run" --types op || echo '"patina log events failed"'; } | jq -rn --argjson roots "$roots" '
  first(inputs | if type == "string" then error(.) else . end
    | select(.op | IN("close", "fsync", "fsync-dir", "fsync-fail", "sync") | not) | . as $e
    | (.path, .to) | strings | . as $p
    | select(all($roots[]; . as $r | $p != $r and ($p | startswith($r + "/") | not)))
    | "\($e.op) \($p) (seq \($e.seq))") // empty')
[ -z "$bad" ] || { echo "outside-roots: $bad"; exit 1; }
