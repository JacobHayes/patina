#!/bin/sh
# synced-before-mark FILE PREFIX RUN: when the program marks an acknowledgement (SDK `mark`
# with a label starting PREFIX, as "ack 17"), no write to FILE (/work/data.log) is still
# unsynced. Other marks are ignored. Reads the `op` and `mark` events of `patina inspect events`.
# For `patina run --check`.
set -eu
file=$1 prefix=$2 run=$3
bad=$({ "${PATINA:-patina}" inspect events "$run" --types boot,op,mark || echo '"patina inspect events failed"'; } | jq -rn --arg f "$file" --arg p "$prefix" '
  first(foreach (inputs | if type == "string" then error(.) else . end) as $e ({dirty: false};
      if $e.type == "boot" then .dirty = false
      elif $e.type == "op" and $e.path == $f and ($e.op | IN("write", "truncate", "fallocate", "mmap-dirty")) then .dirty = true
      elif $e.type == "op" and (($e.path == $f and $e.op == "fsync" and ($e.flags / 2 | floor) % 2 == 0) or $e.op == "sync") then .dirty = false
      elif $e.type == "mark" and (($e.label // "") | startswith($p)) then .bad = (if .dirty then $e else null end)
      else .bad = null end;
      select(.bad) | "\(.bad.label) (seq \(.bad.seq))")) // empty')
[ -z "$bad" ] || { echo "ack-before-fsync: $bad follows an unsynced write to $file"; exit 1; }
