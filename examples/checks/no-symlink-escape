#!/bin/sh
# no-symlink-escape ROOT... RUN: every file the program opened resolves under one of the
# ROOTs, symlinks followed: a link planted in a served directory, or one a path swap made
# between a check and the open, does not take it elsewhere. Reads `resolved` of each open in
# `patina log events`. For `patina run --check`.
set -eu
for run; do :; done
roots=$(for r; do [ "$r" = "$run" ] || printf '%s\n' "$r"; done | jq -Rsc 'split("\n")[:-1] | map(if . == "/" then . else rtrimstr("/") end)')
bad=$({ "${PATINA:-patina}" log events "$run" --types call || echo '"patina log events failed"'; } | jq -rn --argjson roots "$roots" '
  first(inputs | if type == "string" then error(.) else . end
    | select(.type == "call" and (.name | IN("open", "openat", "openat2", "creat")) and .ret >= 0 and .resolved)
    | select(.resolved as $p | all($roots[]; . as $r | $p != $r and ($p | startswith($r + "/") | not)))
    | "\(.path) -> \(.resolved) (seq \(.seq))") // empty')
[ -z "$bad" ] || { echo "symlink-escape: $bad"; exit 1; }
